# Managed by Ansible — do not edit by hand
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Loopback
-A INPUT -i lo -j ACCEPT

# Stateful — allow established/related traffic back in
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# {{ nic_analyst }} — analyst LAN, unrestricted access
-A INPUT -i {{ nic_analyst }} -j ACCEPT

# {{ nic_target }} — target network, Elastic Agent callback ports only
-A INPUT -i {{ nic_target }} -p tcp --dport {{ elastic_logstash_port }} -j ACCEPT
-A INPUT -i {{ nic_target }} -p tcp --dport {{ elastic_fleet_port }} -j ACCEPT
-A INPUT -i {{ nic_target }} -j DROP

# {{ nic_wg_bearer }} — Bearer of Opportunity, WireGuard only
-A INPUT -i {{ nic_wg_bearer }} -p udp --dport {{ wireguard_port }} -j ACCEPT
-A INPUT -i {{ nic_wg_bearer }} -j DROP

COMMIT
