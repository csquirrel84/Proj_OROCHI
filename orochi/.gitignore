# Orochi Security Stack - Git Ignore
# ==============================================

# Environment configuration (contains secrets)
.env

# Ansible vault password file
.vault_pass
.vault_password
.claude*


# Ansible retry files
*.retry

# Install log (per-run, not for version control)
install.log

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# IDE/Editor directories
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
