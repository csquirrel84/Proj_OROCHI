  - '      - ${CONFIG_DIR:-/etc/rita}/logger-cron:/etc/cron.d/logger-cron'
  - '      - ${CONFIG_DIR:-/etc/rita}/syslog-ng.conf:/config/syslog-ng.conf'
  - '      - ${APP_LOGS:-/var/log/rita}:/config/logs/rita'
  - '    # ports:'
  - '    #   - 514:5514/udp'
  - '    #   - 601:6601/tcp'
  - '    #   - 6514:6514/tcp'
  - '    expose:'
  - '      - 5514/udp'
  - '      - 6601/tcp'
  - '    restart: unless-stopped'
  - '  clickhouse:'
  - '    image: 100.99.102.28:5000/rita/clickhouse-server:${CLICKHOUSE_VERSION?"Missing ClickHouse version"}'
  - '    container_name: rita-clickhouse'
  - '    healthcheck:'
  - '      test: wget --no-verbose --tries=1 --spider http://localhost:8123/ping || exit 1'
  - '      interval: 3s'
  - '      start_period: 1s'
  - '      retries: 30'
  - '    restart: unless-stopped'
  - '    expose:'
  - '      - 9000'
  - '    # ports:'
