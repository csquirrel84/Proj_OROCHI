  - '    links:'
  - '      - "clickhouse:db"'
  - '      - "syslog-ng:syslogng"'
  - '    environment:'
  - '      - DB_ADDRESS=db:9000'
  - '      - TERM=xterm-256color'
  - ''
  - '  syslog-ng:'
  - '    image: 100.99.102.28:5000/rita/syslog-ng:latest'
  - '    container_name: rita-syslog-ng'
  - '    environment:'
  - '      - PUID=1000'
  - '      - PGID=1000'
  - '      - TZ=Etc/UTC'
  - '    volumes:'
